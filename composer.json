{
    "name": "yu-laravel/security-check",
    "description": "Laravel Livewire tool that checks a site's SSL certificate, HTTPS redirect and security headers.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "security",
        "ssl",
        "security-headers"
    ],
    "homepage": "https://github.com/yuriyakishin/security-check",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "yu-laravel/web-tools-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Yu\\SecurityCheck\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\SecurityCheck\\SecurityCheckServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
